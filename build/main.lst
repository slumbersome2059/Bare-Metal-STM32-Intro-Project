  92:Core/Src/hal.h **** inline GPIO *getGPIO(char bank){
  93:Core/Src/hal.h ****     //GPIO *gpioPins[GPIO_BANK_NUMBER] = {0, 0, 0, 0, 0};
  94:Core/Src/hal.h ****     int base = 0x50000000;
  95:Core/Src/hal.h ****     int offset = 0x400;
  96:Core/Src/hal.h ****     int i = bank - 'A';
  97:Core/Src/hal.h ****     return (GPIO *)(base + i*(offset));
  98:Core/Src/hal.h **** } 
  99:Core/Src/hal.h **** static inline void setModeGPIO(char bank, int pinNum, GPIO_mode gM){
 100:Core/Src/hal.h ****     GPIO *gpioBank = getGPIO(bank);
 101:Core/Src/hal.h ****     //pin numbers start from 0 so you can have A0 and mode for pin number stored as two bits in pin
 102:Core/Src/hal.h ****     setReg(&(gpioBank->MODER), pinNum, 2, gM);
 103:Core/Src/hal.h ****     //U is added after 3 to make it unsigned to avoid any strange errors that may happen
 104:Core/Src/hal.h **** }
 105:Core/Src/hal.h **** 
 106:Core/Src/hal.h **** static inline void setAltFuncGPIO(char bank, int pinNum, int afNum){
 107:Core/Src/hal.h ****     GPIO *gpioBank = getGPIO(bank);
 108:Core/Src/hal.h ****     if(pinNum <= 7){
 109:Core/Src/hal.h ****         setReg(&(gpioBank->AFRL), pinNum, 4, afNum);
 110:Core/Src/hal.h ****     }else if(pinNum >= 8 && pinNum <= 15){
 111:Core/Src/hal.h ****         setReg(&(gpioBank->AFRH), pinNum - 8, 4, afNum);//setReg requires an index so you need to -
 112:Core/Src/hal.h ****     }
 113:Core/Src/hal.h ****     
 114:Core/Src/hal.h **** }
 115:Core/Src/hal.h **** 
 116:Core/Src/hal.h **** static inline void writeGPIO(char bank, int pinNum, int val){
 117:Core/Src/hal.h ****     GPIO *gpioBank = getGPIO(bank);
 118:Core/Src/hal.h ****     gpioBank->BSRR = (1U << (pinNum+(val ? 0: 16)));
 119:Core/Src/hal.h **** }
 120:Core/Src/hal.h **** /*
 121:Core/Src/hal.h **** 
 122:Core/Src/hal.h ****     - Making a BSRR pin 1 will mean a write or reset happens to the pin number
 123:Core/Src/hal.h ****     on ODR which stores the output and a 0 means ODR will not be assigned
 124:Core/Src/hal.h ****     - if you pass in 0, to write 0 you need to reset so you need to make 1 the bits of 16 to 31
 125:Core/Src/hal.h ****     on BSRR which will reset the bit on ODR
 126:Core/Src/hal.h ****     - There are only 0 to 15 bits on ODR
 127:Core/Src/hal.h ****     - You can modify the ODR directly but writing one bit require a read(taking ODR value 
 128:Core/Src/hal.h ****     into register as you want to preserve the values in other bits), modify(bitwise 
 129:Core/Src/hal.h ****     OR), write(back to ODR) series of steps
 130:Core/Src/hal.h ****     - This violates atomicity so after you have read if there is an interrupt and 
 131:Core/Src/hal.h ****     it modifies some other bit of same ODR and then your modify and write happens
 132:Core/Src/hal.h ****     , this would mean that the modification made by interrupt would be lost as you
 133:Core/Src/hal.h ****     modify old read and then write that back
 134:Core/Src/hal.h ****     - With BSRR you directly write(look at the '=') to the register and there is 
 135:Core/Src/hal.h ****     no read or modify loop when you change data of BSRR in the software and in same 
 136:Core/Src/hal.h ****     cycle of writing to BSRR the ODR value is updated as well
 137:Core/Src/hal.h ****     - The whole bit (re)/setting of ODR is done in one cycle so atomic
 138:Core/Src/hal.h ****     */
 139:Core/Src/hal.h **** //Initialises the counting process and returns a success value 
 140:Core/Src/hal.h **** //on whether it worked or not (-1 for failure and 0 for success)

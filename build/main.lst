  44:Core/Src/main.c ****     (void)*RCC_APBENR1; // Dummy read forces CPU to wait for clock stabilization
  45:Core/Src/main.c ****     uart2->CR1 = 0;//UART(from setting UE bit to 0) needs to be disabled for some bits to be set
  46:Core/Src/main.c ****     uart2->BRR = (uint32_t)(48000000/115200);
  47:Core/Src/main.c ****     uart2->CR1 = 13;

  55:Core/Src/main.c ****             /*
  56:Core/Src/main.c ****             This is TXE bit which is used to show TDR is free and the data in there has 
  57:Core/Src/main.c ****             been moved to shift register so you can write there
  58:Core/Src/main.c ****             There is a TC bit which shows the whole transmission is complete so shift register is e
ARM GAS  /tmp/cciTSmtz.s 			page 6


  59:Core/Src/main.c ****             and TX line is IDLE. This is used right at the end so that you don't disable 
  60:Core/Src/main.c ****             the USART when there is data in shift register for example. But TC does not seem to wor
  61:Core/Src/main.c ****              on STM32 when I use it here. For example, using TC should mean loop runs longer but no
  62:Core/Src/main.c ****              change in output while only first letter gets printed in reality.
  63:Core/Src/main.c ****             */
  64:Core/Src/main.c ****             delay(1);
  65:Core/Src/main.c ****         };
  66:Core/Src/main.c ****     }    
  67:Core/Src/main.c **** }

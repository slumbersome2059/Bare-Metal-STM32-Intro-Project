  53:Core/Src/main.c **** void uint_to_str(uint16_t val, char *str) {
  54:Core/Src/main.c ****     /*
  55:Core/Src/main.c ****     This loops through each of the powers of 10 and repeatedly does subtraction if val is less than
  56:Core/Src/main.c ****     It then displays the string from this.
  57:Core/Src/main.c ****     The length of the array passed in should be 1 more than the space that the number 
  58:Core/Src/main.c ****     takes because you need space for \0. 
  59:Core/Src/main.c ****     */
  60:Core/Src/main.c **** 
  61:Core/Src/main.c ****     // Powers of 10 for up to a 16-bit unsigned integer
  62:Core/Src/main.c ****     static const uint16_t powers[5] = {
  63:Core/Src/main.c ****         10000U, 1000U, 100U, 10U, 1U
  64:Core/Src/main.c ****     };
  65:Core/Src/main.c ****     
  66:Core/Src/main.c ****     int idx = 0;
  67:Core/Src/main.c ****     bool leading_zero = true;
  68:Core/Src/main.c **** 
  69:Core/Src/main.c ****     if (val == 0) {
  70:Core/Src/main.c ****         str[0] = '0';
  71:Core/Src/main.c ****         str[1] = '\0';
  72:Core/Src/main.c ****         return;
  73:Core/Src/main.c ****     }
  74:Core/Src/main.c **** 
  75:Core/Src/main.c ****     for (int i = 0; i < 5; i++) {
  76:Core/Src/main.c ****         uint16_t p = powers[i];
  77:Core/Src/main.c ****         char count = '0';
  78:Core/Src/main.c ****         
  79:Core/Src/main.c ****         while (val >= p) {
  80:Core/Src/main.c ****             val -= p;
  81:Core/Src/main.c ****             count++;
  82:Core/Src/main.c ****         }
  83:Core/Src/main.c ****         
  84:Core/Src/main.c ****         // Skip leading zeros
  85:Core/Src/main.c ****         if (count != '0' || !leading_zero) {
  86:Core/Src/main.c ****             leading_zero = false;
  87:Core/Src/main.c ****             str[idx++] = count;
  88:Core/Src/main.c ****         }
ARM GAS  /tmp/ccVWJYEU.s 			page 3


  89:Core/Src/main.c ****     }
  90:Core/Src/main.c ****     
  91:Core/Src/main.c ****     str[idx] = '\0';
  92:Core/Src/main.c **** }

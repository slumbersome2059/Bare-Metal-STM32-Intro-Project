  96:Core/Src/main.c **** void uint_to_str(uint16_t val, char *str) {
  97:Core/Src/main.c ****     /*
  98:Core/Src/main.c ****     This loops through each of the powers of 10 and repeatedly does subtraction if val is less than
  99:Core/Src/main.c ****     It then displays the string from this.
 100:Core/Src/main.c ****     The length of the array passed in should be 1 more than the space that the number 
 101:Core/Src/main.c ****     takes because you need space for \0. 
 102:Core/Src/main.c ****     */
 103:Core/Src/main.c **** 
 104:Core/Src/main.c ****     // Powers of 10 for up to a 16-bit unsigned integer
 105:Core/Src/main.c ****     static const uint16_t powers[5] = {
 106:Core/Src/main.c ****         10000U, 1000U, 100U, 10U, 1U
 107:Core/Src/main.c ****     };
 108:Core/Src/main.c ****     
 109:Core/Src/main.c ****     int idx = 0;
 110:Core/Src/main.c ****     bool leading_zero = true;
 111:Core/Src/main.c **** 
 112:Core/Src/main.c ****     if (val == 0) {
 113:Core/Src/main.c ****         str[0] = '0';
 114:Core/Src/main.c ****         str[1] = '\0';
 115:Core/Src/main.c ****         return;
ARM GAS  /tmp/cciTSmtz.s 			page 7


 116:Core/Src/main.c ****     }
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****     for (int i = 0; i < 5; i++) {
 119:Core/Src/main.c ****         uint16_t p = powers[i];
 120:Core/Src/main.c ****         char count = '0';
 121:Core/Src/main.c ****         
 122:Core/Src/main.c ****         while (val >= p) {
 123:Core/Src/main.c ****             val -= p;
 124:Core/Src/main.c ****             count++;
 125:Core/Src/main.c ****         }
 126:Core/Src/main.c ****         
 127:Core/Src/main.c ****         // Skip leading zeros
 128:Core/Src/main.c ****         if (count != '0' || !leading_zero) {
 129:Core/Src/main.c ****             leading_zero = false;
 130:Core/Src/main.c ****             str[idx++] = count;
 131:Core/Src/main.c ****         }
 132:Core/Src/main.c ****     }
 133:Core/Src/main.c ****     
 134:Core/Src/main.c ****     str[idx] = '\0';
 135:Core/Src/main.c **** }

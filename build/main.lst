  15:Core/Src/hal.h **** 
  16:Core/Src/hal.h **** struct UART{
  17:Core/Src/hal.h ****     volatile uint32_t CR1, CR2, CR3, BRR, GTPR, RTQR, RQR, ISR, ICR, RDR, TDR, PRESC;
  18:Core/Src/hal.h ****     /*
  19:Core/Src/hal.h ****     - BRR -> set the baud rate, for UART and USART this is the amount of data transmitted per secon
  20:Core/Src/hal.h ****     - GTPR -> sets the guard time value(transmission complete flag set after this 
  21:Core/Src/hal.h ****     time is drained), and sets prescaler value which divides system clock -> both these values are 
  22:Core/Src/hal.h ****      accessed in certain modes and not in normal mode
  23:Core/Src/hal.h ****     - RTOR -> receiver timeout register, sets a flag after some time 
  24:Core/Src/hal.h ****     where nothing is to be read
  25:Core/Src/hal.h ****     - RQR -> used to make requests like discard data without reading it, or put USART in mute mode
  26:Core/Src/hal.h ****     - ISR -> gives information on the status of the USART like a busy flag if there is comms on the
  27:Core/Src/hal.h ****     - ICR -> clears flags of ISR, same idea of BSRR used for ODR
  28:Core/Src/hal.h ****     - RDR -> contains data character received
  29:Core/Src/hal.h ****     - TDR -> contains data character to be transmitted
  30:Core/Src/hal.h ****     - PRESC -> used to divide the input clock by some number 
  31:Core/Src/hal.h ****     */

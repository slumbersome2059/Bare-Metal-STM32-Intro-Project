  12:Core/Src/hal.h ****     volatile uint32_t SYST_CSR, SYST_RVR, SYST_CVR, SYST_CALIB;  
  13:Core/Src/hal.h **** };
  14:Core/Src/hal.h **** 
  15:Core/Src/hal.h **** struct UART{
  16:Core/Src/hal.h ****     volatile uint32_t CR1, CR2, CR3, BRR, GTPR, RTQR, RQR, ISR, ICR, RDR, TDR, PRESC;
  17:Core/Src/hal.h ****     /*
  18:Core/Src/hal.h ****     - BRR -> set the baud rate, for UART and USART this is the amount of data transmitted per secon
  19:Core/Src/hal.h ****     - GTPR -> sets the guard time value(transmission complete flag set after this 
  20:Core/Src/hal.h ****     time is drained), and sets prescaler value which divides system clock -> both these values are 
  21:Core/Src/hal.h ****      accessed in certain modes and not in normal mode
  22:Core/Src/hal.h ****     - RTOR -> receiver timeout register, sets a flag after some time 
  23:Core/Src/hal.h ****     where nothing is to be read
  24:Core/Src/hal.h ****     - RQR -> used to make requests like discard data without reading it, or put USART in mute mode
  25:Core/Src/hal.h ****     - ISR -> gives information on the status of the USART like a busy flag if there is comms on the
  26:Core/Src/hal.h ****     - ICR -> clears flags of ISR, same idea of BSRR used for ODR
  27:Core/Src/hal.h ****     - RDR -> contains data character received
  28:Core/Src/hal.h ****     - TDR -> contains data character to be transmitted
  29:Core/Src/hal.h ****     - PRESC -> used to divide the input clock by some number 
  30:Core/Src/hal.h ****     */
  31:Core/Src/hal.h **** };

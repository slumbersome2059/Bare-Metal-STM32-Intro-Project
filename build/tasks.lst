 123:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 
 124:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** /* uxTopReadyPriority holds the priority of the highest priority ready
 125:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****  * state task. */
 126:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****     #define taskRECORD_READY_PRIORITY( uxPriority ) \
 127:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****     {                                               \
 128:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****         if( ( uxPriority ) > uxTopReadyPriority )   \
 129:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****         {                                           \
 130:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****             uxTopReadyPriority = ( uxPriority );    \
 131:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****         }                                           \
 132:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****     } /* taskRECORD_READY_PRIORITY */

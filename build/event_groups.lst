  53:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventCLEAR_EVENTS_ON_EXIT_BIT    0x0100U
  54:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventUNBLOCKED_DUE_TO_BIT_SET    0x0200U
  55:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventWAIT_FOR_ALL_BITS           0x0400U
  56:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventEVENT_BITS_CONTROL_BYTES    0xff00U
  57:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c **** #else
  58:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventCLEAR_EVENTS_ON_EXIT_BIT    0x01000000UL
  59:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventUNBLOCKED_DUE_TO_BIT_SET    0x02000000UL
  60:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventWAIT_FOR_ALL_BITS           0x04000000UL
  61:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c ****     #define eventEVENT_BITS_CONTROL_BYTES    0xff000000UL
  62:Middlewares/Third_Party/FreeRTOS/Source/event_groups.c **** #endif

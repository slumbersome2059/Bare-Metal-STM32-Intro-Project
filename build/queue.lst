2491:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         /* If the queue is already full we may have to block.  A critical section
2492:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****          * is required to prevent an interrupt removing something from the queue
2493:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****          * between the check to see if the queue is full and blocking on the queue. */
2494:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         portDISABLE_INTERRUPTS();
2495:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****         {
2496:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             if( prvIsQueueFull( pxQueue ) != pdFALSE )
2497:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****             {
2498:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                 /* The queue is full - do we want to block or just leave without
2499:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                  * posting? */
2500:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                 if( xTicksToWait > ( TickType_t ) 0 )
2501:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                 {
2502:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                     /* As this is called from a coroutine we cannot block directly, but
2503:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                      * return indicating that we need to block. */
2504:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                     vCoRoutineAddToDelayedList( xTicksToWait, &( pxQueue->xTasksWaitingToSend ) );
2505:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                     portENABLE_INTERRUPTS();
2506:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                     return errQUEUE_BLOCKED;
2507:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                 }
2508:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                 else
2509:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                 {
2510:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                     portENABLE_INTERRUPTS();
2511:Middlewares/Third_Party/FreeRTOS/Source/queue.c ****                     return errQUEUE_FULL;

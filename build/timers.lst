 674:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****          * this task to unblock when the tick count overflows, at which point the
 675:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****          * timer lists will be switched and the next expiry time can be
 676:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****          * re-assessed.  */
 677:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         *pxListWasEmpty = listLIST_IS_EMPTY( pxCurrentTimerList );
 678:Middlewares/Third_Party/FreeRTOS/Source/timers.c **** 
 679:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         if( *pxListWasEmpty == pdFALSE )
 680:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         {
 681:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****             xNextExpireTime = listGET_ITEM_VALUE_OF_HEAD_ENTRY( pxCurrentTimerList );
 682:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         }
 683:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         else
 684:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         {
 685:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****             /* Ensure the task unblocks when the tick count rolls over. */
 686:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****             xNextExpireTime = ( TickType_t ) 0U;
 687:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         }
 688:Middlewares/Third_Party/FreeRTOS/Source/timers.c **** 
 689:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****         return xNextExpireTime;
 690:Middlewares/Third_Party/FreeRTOS/Source/timers.c ****     }
